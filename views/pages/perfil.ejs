<!DOCTYPE html>
<html lang="pt-BR">
<%- include("../partials/head", { title }) %>

<body>
  <%- include("../partials/header") %>

  <main class="profile-page">
    <section class="profile-personal-section">
      <div class="profile-content">
        <h1>Dados Pessoais</h1>

        <form id="profileForm" class="profile-form">
          <div class="profile-field">
            <label for="profileName">Nome</label>

            <div class="profile-input-row">
              <input
                type="text"
                id="profileName"
                placeholder="Digite seu nome"
                disabled
              />

              <button type="button" class="edit-field-button" data-edit="profileName">
                ✎
              </button>
            </div>
          </div>

          <div class="profile-field">
            <label for="profileEmail">E-mail</label>

            <div class="profile-input-row">
              <input
                type="email"
                id="profileEmail"
                placeholder="Digite seu e-mail"
                disabled
              />

              <button type="button" class="edit-field-button" data-edit="profileEmail">
                ✎
              </button>
            </div>
          </div>

          <div class="profile-field">
            <label for="profilePassword">Senha</label>

            <div class="profile-input-row">
              <input
                type="password"
                id="profilePassword"
                placeholder="Nova senha opcional"
                disabled
              />

              <button type="button" class="edit-field-button" data-edit="profilePassword">
                ✎
              </button>
            </div>
          </div>

          <button type="submit" class="save-profile-button">
            💾 Salvar alterações
          </button>
        </form>
      </div>
    </section>

    <section class="profile-plans-section">
      <div class="profile-content">
        <h2>Planos</h2>

        <div id="profilePlanArea" class="profile-plan-area">
          <!-- Plano carregado pelo perfil.js -->
        </div>
      </div>
    </section>

    <section class="profile-danger-section">
      <div class="profile-content">
        <button id="deleteAccountButton" class="delete-account-button">
          🗑 Excluir Conta
        </button>
      </div>
    </section>
  </main>

  <%- include("../partials/footer", { backHref: "/", backText: "Voltar" }) %>

  <script src="/js/nav.js"></script>
  <script src="/js/perfil.js"></script>
</body>
</html>