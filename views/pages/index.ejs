<!DOCTYPE html>
<html lang="pt-BR">
<%- include("../partials/head", { title }) %>

<body>
  <%- include("../partials/header") %>

  <main>
    <section class="hero">
      <div class="hero-content">
        <h1>Controle financeiro de projetos, sem planilhas intermináveis.</h1>

        <p>
          Centralize receitas e despesas e acompanhe indicadores claros para evitar
          estouros de orçamento.
        </p>

        <div class="hero-buttons">
          <a href="/planos" class="btn btn-primary">Experimentar</a>
          <a href="#recursos" class="btn btn-secondary">Ver recursos</a>
        </div>
      </div>
    </section>

    <section id="recursos" class="section recursos-section">
      <h2>Recursos</h2>

      <div class="cards-grid">
        <article class="resource-card">
          <h3>Dashboards simples</h3>
          <p>Indicadores essenciais para decidir rápido.</p>
        </article>

        <article class="resource-card">
          <h3>Centralização</h3>
          <p>Um lugar para controlar tudo do projeto.</p>
        </article>

        <article class="resource-card">
          <h3>Menos erros</h3>
          <p>Padronização e validação reduzem retrabalho.</p>
        </article>
      </div>
    </section>

    <section id="planos" class="section planos-section">
      <h2>Planos</h2>

      <div class="plans-grid">
        <article class="plan-card">
          <h3>Básico</h3>

          <p>Para equipes pequenas e poucos projetos.</p>

          <ul>
            <li>Até 3 projetos</li>
            <li>Relatório simples</li>
            <li>Suporte por e-mail</li>
          </ul>

          <a href="/planos" class="btn btn-small">Ver mais</a>
        </article>

        <article class="plan-card">
          <h3>Pro</h3>

          <p>Para equipes com maior controle financeiro.</p>

          <ul>
            <li>Projetos ilimitados</li>
            <li>Indicadores avançados</li>
            <li>Suporte prioritário</li>
          </ul>

          <a href="/planos" class="btn btn-small">Ver mais</a>
        </article>
      </div>
    </section>
  </main>

  <%- include("../partials/footer", { backHref: "/contato", backText: "Contato" }) %>

  <script src="/js/nav.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>