<!DOCTYPE html>
<html lang="pt-BR">
<%- include("../partials/head", { title }) %>

<body>
  <%- include("../partials/header") %>

  <main class="plans-page">
    <section class="plans-intro">
      <h1>Planos Disponíveis</h1>

      <p>
        Selecione o plano que mais se encaixa com sua equipe e suas necessidades.
      </p>
    </section>

    <section class="plans-list">
      <article class="plan-preview-card">
        <img
          src="/assets/images/plano-basico.jpg"
          alt="Equipe pequena analisando dados do projeto"
          class="plan-preview-image"
        />

        <div class="plan-preview-content">
          <h2>Básico</h2>

          <p>Para equipes pequenas e poucos projetos.</p>

          <ul>
            <li>Até 3 projetos</li>
            <li>Relatório simples</li>
            <li>Suporte por e-mail</li>
          </ul>

          <div class="plan-card-actions">
            <a href="/detalhes-plano?plano=basico" class="btn-details">
              Ver detalhes
            </a>

            <a href="/pagamento?plano=basico&periodo=mensal" class="btn btn-small">
              Escolher
            </a>
          </div>
        </div>
      </article>

      <article class="plan-preview-card">
        <img
          src="/assets/images/plano-pro.jpg"
          alt="Equipe acompanhando planejamento de projeto"
          class="plan-preview-image"
        />

        <div class="plan-preview-content">
          <h2>Pro</h2>

          <p>Para equipes com múltiplos projetos.</p>

          <ul>
            <li>Projetos ilimitados</li>
            <li>Indicadores avançados</li>
            <li>Suporte prioritário</li>
          </ul>

          <div class="plan-card-actions">
            <a href="/detalhes-plano?plano=pro" class="btn-details">
              Ver detalhes
            </a>

            <a href="/pagamento?plano=pro&periodo=mensal" class="btn btn-small">
              Escolher
            </a>
          </div>
        </div>
      </article>
    </section>
  </main>

  <%- include("../partials/footer", { backHref: "/", backText: "Voltar" }) %>

  <script src="/js/nav.js"></script>
</body>
</html>